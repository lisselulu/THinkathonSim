agents/interpretations/*
!agents/interpretations/_starter.json
agents/interpretations.json
agents/calibration.json

# Scratch output of the JS/Python parity check
engine/.parity/
__pycache__/
*.pyc

# Local tool settings
.claude/
node_modules/
